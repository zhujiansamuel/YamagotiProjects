# =============================================================================
# YamagotiProjects 环境变量配置示例
# 复制此文件为 .env 并根据环境修改
# =============================================================================

# -----------------------------------------------------------------------------
# Django 配置
# -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ENV=dev

# -----------------------------------------------------------------------------
# 数据库配置
# -----------------------------------------------------------------------------
# 是否使用 PgBouncer 连接池
# - 开发环境: false (直连 PostgreSQL)
# - 生产环境: true (通过 PgBouncer)
USE_PGBOUNCER=true

# PostgreSQL 直连配置 (当 USE_PGBOUNCER=false 时使用)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DATABASE=applestockchecker_dev
POSTGRES_USER=samuelzhu
POSTGRES_PASSWORD=YOUR_PASSWORD

# PgBouncer 配置 (当 USE_PGBOUNCER=true 时使用)
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=5432
PGBOUNCER_DATABASE=applestockchecker_dev
PGBOUNCER_USER=samuelzhu
PGBOUNCER_PASSWORD=YOUR_PASSWORD

# -----------------------------------------------------------------------------
# Redis 配置
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# -----------------------------------------------------------------------------
# Celery 配置
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_CONCURRENCY_DEFAULT=4
CELERY_CONCURRENCY_WEBSCRAPER=2

# -----------------------------------------------------------------------------
# WebScraper API 配置
# -----------------------------------------------------------------------------
WEB_SCRAPER_API_TOKEN=your-webscraper-api-token
WEB_SCRAPER_WEBHOOK_TOKEN=your-webhook-token

# -----------------------------------------------------------------------------
# 外部商品价格同步配置
# -----------------------------------------------------------------------------
EXTERNAL_GOODS_API_URL=http://localhost:8080
EXTERNAL_GOODS_API_TOKEN=your-external-api-token-here
EXTERNAL_GOODS_CATEGORY_FILTER=iPhone

# -----------------------------------------------------------------------------
# CORS 配置
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# 其他配置
# -----------------------------------------------------------------------------
TREND_MAX_LOOKBACK_DAYS=90
TREND_DB_MAX_WORKERS=6

# =============================================================================
# Docker Compose 内部使用的变量（通常不需要修改）
# =============================================================================
# 这些变量在 docker-compose.yml 中使用
# 如果需要在容器外部运行，请相应调整 HOST 值

# 容器内部网络地址
# PGBOUNCER_HOST=pgbouncer    # Docker 网络内
# REDIS_HOST=redis            # Docker 网络内

# 本地开发时的外部访问地址
# PGBOUNCER_HOST=127.0.0.1    # 本地访问
# REDIS_HOST=127.0.0.1        # 本地访问
